        "jsCode": "const leader_ids = items[0].json.leader_ids;\nconst userId = items[0].json.message.from.id;\nlet isLeader = false;\n\nconsole.log(\"leader_ids:\", leader_ids);\nconsole.log(\"userId:\", userId);\n\nif (leader_ids.includes(userId)) {\n  isLeader = true;\n}\n\nconsole.log(\"isLeader:\", isLeader);\n\nreturn [{\n  json: {\n    ...items[0].json,\n        \"isLeader\": isLeader\n  }\n}];"
